<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		x:Class="DOMSimple.MainWindow"
		Title="List &amp; Label Cross Platform Simple DOM Sample"
		Width="640" Height="630"
		CanMaximize="false" CanResize="false">

	<Window.Styles>
		<Style Selector="HeaderedContentControl">
			<Setter Property="Template">
				<ControlTemplate>
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<!-- Header -->
						<Border
						ZIndex="1"
						Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
						Padding="5,0,5,0"
						Margin="5,0,0,0">
							<TextBlock
							Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
							FontWeight="Bold"/>
						</Border>
						<!-- Content Area -->
						<Border
						Grid.RowSpan="2"
						Padding="5,5,0,0"
						Grid.ColumnSpan="2"
						CornerRadius="4"
						Margin="0,10,0,0"
						BorderBrush="LightGray"
						BorderThickness="1">
							<ContentPresenter
							Name="PART_ContentPresenter"
							Padding="8"
							Content="{TemplateBinding Content}"/>
						</Border>
					</Grid>
				</ControlTemplate>
			</Setter>
		</Style>
	</Window.Styles>

	<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,10,0,0">
		<TextBlock Grid.Row="0" Grid.Column="0" Margin="20, 10, 10, 0" Text="D:" VerticalAlignment="Top" />
		<TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 10, 0, 0" Width="500" TextWrapping="Wrap" Text="Dieses Beispiel zeigt die dynamische Erstellung von List &#x26; Label CrossPlatform Projekten."/>
		<TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="20, 15, 10, 0" TextWrapping="Wrap" Text="US:"/>
		<TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 15, 10, 10" Width="500" TextWrapping="Wrap" Text="This sample shows the dynamic creation of List &#x26; Label CrossPlatform projects." />
		<HeaderedContentControl Header="Project Layout" Grid.Row="2" Grid.Column="1" Margin="0, 10" VerticalAlignment="Top" HorizontalAlignment="Left" Width="540" Height="440">
			<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,10,0,0">
				<TextBlock Text="Table" FontSize="12" Margin="0, 0, 10, 0" VerticalAlignment="Top" />
				<ComboBox x:Name="ComboboxTables" SelectionChanged="ComboboxTables_SelectionChanged" FontSize="12" Margin="0, 20, 0, 0" Width="505" />
				<TextBlock FontSize="12" Margin="0, 80, 10, 0" HorizontalAlignment="Left" Text="Available Fields" VerticalAlignment="Top" />
				<TextBlock FontSize="12" Margin="0, 80, 0, 0" HorizontalAlignment="Right" Text="Selected Fields" VerticalAlignment="Top" />
				<ListBox x:Name="ListboxAvailable" DoubleTapped="ListboxAvailable_DoubleTapped" FontSize="12" SelectionMode="Multiple,Toggle" Margin="0,110,0,0" Height="120" Width="200" HorizontalAlignment="Left" VerticalAlignment="Top">
					<ListBox.Styles>
							<Style Selector="ListBoxItem">
								<Setter Property="Height" Value="30"/>
								<Setter Property="Padding" Value="2, 2, 2, 2" />
								<Setter Property="VerticalContentAlignment" Value="Center"/>
							</Style>
						</ListBox.Styles>
				</ListBox>
				<ListBox x:Name="ListboxSelected" DoubleTapped="ListboxSelected_DoubleTapped" FontSize="12" SelectionMode="Multiple,Toggle" Margin="0, 110, 0, 0" Height="120" Width="200" HorizontalAlignment="Right" VerticalAlignment="Top" >
					<ListBox.Styles>
							<Style Selector="ListBoxItem">
								<Setter Property="Height" Value="30"/>
								<Setter Property="Padding" Value="2, 2, 2, 2" />
								<Setter Property="VerticalContentAlignment" Value="Center"/>
							</Style>
						</ListBox.Styles>
				</ListBox>
				<Button x:Name="BtnSelect" Content="&#x3E;" Click="SelectField_Click" Height="35" Width="35" Margin="235, 130, 0, 45" HorizontalContentAlignment="Center" VerticalAlignment="Top"/>
				<Button x:Name="BtnUnselect" Content="&#x3C;" Click="SelectField_Click" Height="35" Width="35" Margin="235, 170, 0, 20" HorizontalContentAlignment="Center" VerticalAlignment="Top"/>
				<TextBlock Text="Title" FontSize="12" Margin="0, 250, 0, 0" HorizontalAlignment="Left" VerticalAlignment="Top" />
				<TextBox x:Name="TextboxTitle" FontSize="12" Margin="0, 270, 0, 0" Height="30" Width="505" HorizontalAlignment="Left" VerticalAlignment="Top" />
				<TextBlock Text="Selected Logo" FontSize="12" Margin="0, 320, 0, 0" HorizontalAlignment="Left" VerticalAlignment="Top" />
				<TextBox x:Name="TextboxSelectLogo" FontSize="12" Margin="0, 340, 0, 0" Height="30" Width="460" HorizontalAlignment="Left" VerticalAlignment="Top" />
				<Button x:Name="BtnSelectLogo" Content="..." Click="SelectLogo_Click" Margin="0, 340, 0, 0" Width="35" Height="30" HorizontalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Top" />
			</Grid>
		</HeaderedContentControl>

		<Button Grid.Row="3" Grid.Column="2" x:Name="BtnPrintProject" Click="BtnPrintProject_Click" Content="Print..." Background="DodgerBlue" Foreground="White" Margin="460, 465" HorizontalContentAlignment="Center" Width="81" HorizontalAlignment="Center" />

	</Grid>

</Window>
