@page "/report"

@inject CustomerDataService CustomerData
@inject ReportService        ReportSvc
@inject IJSRuntime           JS

<PageTitle>Customer Report – LLCP Blazor WASM Sample</PageTitle>

<h1>Customer Report</h1>

<p>
    Click <strong>Generate Report</strong> to build a PDF customer list using
    List &amp; Label Cross Platform — entirely inside your browser.
</p>

<!-- ── Data preview table ─────────────────────────────────────────────────── -->
<h2>Data Source</h2>
<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>City</th>
            <th>Revenue</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in _customers)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Name</td>
                <td>@c.City</td>
                <td>@c.Revenue.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>

<!-- ── Generate button and status ────────────────────────────────────────── -->
<div class="mt-3">
    <button class="btn btn-primary" @onclick="GenerateReportAsync" disabled="@_isGenerating">
        @if (_isGenerating)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            <span>Generating…</span>
        }
        else
        {
            <span>📄 Generate Report</span>
        }
    </button>
</div>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger mt-3" role="alert">
        <strong>Error:</strong> @_errorMessage
    </div>
}

@if (_successMessage is not null)
{
    <div class="alert alert-success mt-3" role="alert">
        @_successMessage
    </div>
}

@code {
    private IReadOnlyList<Customer> _customers = Array.Empty<Customer>();
    private bool    _isGenerating  = false;
    private string? _errorMessage  = null;
    private string? _successMessage = null;

    protected override void OnInitialized()
    {
        _customers = CustomerData.GetCustomers();
    }

    /// <summary>
    /// Generates the PDF report and triggers a browser download.
    /// </summary>
    private async Task GenerateReportAsync()
    {
        _isGenerating   = true;
        _errorMessage   = null;
        _successMessage = null;

        // Yield to the Blazor render loop so the spinner becomes visible
        // before the (synchronous) report generation blocks the thread.
        await Task.Yield();

        try
        {
            // All LLCP work runs synchronously inside the WASM sandbox.
            byte[] pdfBytes = ReportSvc.GenerateCustomerReport(_customers);

            // Trigger a browser file-download using JavaScript interop.
            await DownloadFileAsync("CustomerReport.pdf", "application/pdf", pdfBytes);

            _successMessage = $"Report generated successfully ({pdfBytes.Length:N0} bytes). " +
                               "Your browser should prompt a download.";
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isGenerating = false;
        }
    }

    /// <summary>
    /// Uses a small inline JavaScript snippet to download a byte array as a file.
    /// No separate .js file is needed — the script is injected at runtime.
    /// </summary>
    private async Task DownloadFileAsync(string fileName, string mimeType, byte[] data)
    {
        // Convert the byte array to a Base64 string and build a data-URL,
        // then simulate an anchor click to trigger the browser download dialog.
        await JS.InvokeVoidAsync(
            "eval",
            $$"""
            (function() {
                const bytes  = atob('{{Convert.ToBase64String(data)}}');
                const arr    = new Uint8Array(bytes.length);
                for (let i = 0; i < bytes.length; i++) arr[i] = bytes.charCodeAt(i);
                const blob   = new Blob([arr], { type: '{{mimeType}}' });
                const url    = URL.createObjectURL(blob);
                const a      = document.createElement('a');
                a.href       = url;
                a.download   = '{{fileName}}';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            })();
            """);
    }
}
