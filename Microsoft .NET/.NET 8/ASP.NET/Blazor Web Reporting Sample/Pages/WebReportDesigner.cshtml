@page 

<script src="~/webreportdesigner.js"></script>

<HeadContent>
    <title>Web Report Designer</title>
</HeadContent>

@{
    Layout = "_Layout";
    string baseUri = $"{Request.Scheme}://{Request.Host}{Request.PathBase}";
    string defaultProject = string.Empty;

    if (BlazorWebReportingSample.CmbtSettings.LanguageSettings.Language == combit.Reporting.LlLanguage.English)
    {
        defaultProject = null;
    }
    else
    { 
        defaultProject = null;
    }
}

<div>

                                                                                    @* US: You can define the ClientData String and pass it to provideListLabelContext here *@
                                                                                    @* D:  Definition eines ClientData strings welcher an provideListLabelContext weitergegeben wird *@
    <ll-webreportdesigner backendurl="@baseUri/LLWebReportDesigner" defaultProject="@defaultProject" showTutorial clientData="{'testdata':'Im a test object'}" />
</div>

