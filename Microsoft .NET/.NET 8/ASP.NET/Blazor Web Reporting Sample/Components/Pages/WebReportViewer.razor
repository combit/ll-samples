<div>
    <ll-webreportviewer backendurl="@baseUri/LLWebReportViewer" defaultProject="@defaultProject" />
</div>

@code {
    string baseUri;
    string defaultProject = "305D94C6-E5DC-4BE1-BC43-12CBC532EEE6";

    protected override void OnInitialized()
    {
        var request = HttpContextAccessor.HttpContext?.Request;
        if (request != null)
        {
            baseUri = $"{request.Scheme}://{request.Host}{request.PathBase}";
        }


        if (BlazorWebReportingSample.CmbtSettings.LanguageSettings.Language == combit.Reporting.LlLanguage.English)
        {
            defaultProject = "42B325E5-A894-4BDE-9D0A-5098B46A5085";
        }
        else
        {
            defaultProject = "305D94C6-E5DC-4BE1-BC43-12CBC532EEE6";
        }

    }
}
