<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		x:Class="Unicode.MainWindow"
		Title="List &amp; Label Cross Platform Unicode Sample"
		Width="520" Height="300"
		CanMaximize="false" CanResize="false">
		
	<Window.Styles>
		<Style Selector="HeaderedContentControl">
			<Setter Property="Template">
				<ControlTemplate>
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<!-- Header -->
						<Border
						ZIndex="1"
						Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
						Padding="5,0,5,0"
						Margin="5,0,0,0">
							<TextBlock
							Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
							FontWeight="Bold"/>
						</Border>
						<!-- Content Area -->
						<Border
						Grid.RowSpan="2"
						Padding="5,5,0,0"
						Grid.ColumnSpan="2"
						CornerRadius="4"
						Margin="0,10,0,0"
						BorderBrush="LightGray"
						BorderThickness="1">
							<ContentPresenter
							Name="PART_ContentPresenter"
							Padding="8"
							Content="{TemplateBinding Content}"/>
						</Border>
					</Grid>
				</ControlTemplate>
			</Setter>
		</Style>
	</Window.Styles>

	<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,10,0,0">
		<TextBlock Grid.Row="0" Grid.Column="0" Margin="20, 10, 10, 0" Text="D:" VerticalAlignment="Top" />
		<TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 10, 0, 0" Width="420" TextWrapping="Wrap" Text="Dieses Beispiel zeigt die Verwendung von Unicode-Inhalten in List &amp; Label Cross Platform Projekten."/>
		<TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="20, 15, 10, 0" TextWrapping="Wrap" Text="US:"/>
		<TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 15, 10, 10" Width="420" TextWrapping="Wrap" Text="This sample shows how to use unicode contents in List &amp; Label Cross Platform projects." />
		<HeaderedContentControl Header="Project type" Grid.Row="2" Grid.Column="1" Margin="0, 10" VerticalAlignment="Top" HorizontalAlignment="Left" Width="180" Height="135">
			<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,10,0,0">
				<RadioButton x:Name="RadioBtnLabel" Grid.Row="0" Content="Label"/>
				<RadioButton x:Name="RadioBtnList" Grid.Row="1" Content="List"/>
			</Grid>
		</HeaderedContentControl>
		<Button x:Name="BtnPrint" Grid.Row="2" Grid.Column="2" Content="Print..." Click="BtnPrint_Click" VerticalAlignment="Top" HorizontalContentAlignment="Center" Width="85" Margin="320, 115"/>
	</Grid>
</Window>
