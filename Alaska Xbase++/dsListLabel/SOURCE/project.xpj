[PROJECT]
    DEBUG         = yes
    LIB           = ..\lib;..\dll
    Version = 2.3
    PROJECT.XPJ

[PROJECT.XPJ]
    LLDemo.EXE

[LLDemo.EXE]
    COMPILE              = xpp
    COMPILE_FLAGS        = /b /q /w /es /wu /wi /wl
    DEBUG_SAVE           = yes
    GUI                  = yes
    LINKER               = alink
    LINK_FLAGS           = /defaultlib:xclass.lib /defaultlib:adsclass.lib /defaultlib:dsListLabel32.LIB  // /defaultlib:[<path>]SQLXPP.LIB
    RC_COMPILE           = arc
    RC_FLAGS             = /v
    INCLUDE              = include;..\dll
    TARGET_DIR           = ..\
    INTERMEDIATE_DEBUG   = ..\.debug
    INTERMEDIATE_RELEASE = ..\.release
    DEPENDS_ON           = $(ASSETS_PATH)\xbphtmlviewer2
// $START-AUTODEPEND
    _panRight.obj
    adsSimple2.obj
    AppSplitter.obj
    AppUtil.obj
    ArrayReportContainer.obj
    dboInvoice.obj
    dboReportContainer.obj
    dboSimple1.obj
    dboSimple2.obj
    dboSimple2Opt.obj
    DrillDown.obj
    Expandable.obj
    Invoice.obj
    Mail.obj
    Main.obj
    panRight.obj
    PDF.obj
    pgHtmlViewer2.obj
    PrintRestAPI.obj
    qrrechnung.obj
    reportcontainer.obj
    Simple1.obj
    Simple2.obj
    Simple2Opt.obj
    Simple2Stream.obj
    SimpleArray.obj
    SimpleDataObject.obj
    SimpleDataObjectLBL.obj
    SimpleInvoice.obj
    sqlADS.obj
    xRechnung.obj
// $STOP-AUTODEPEND
    _panRight.prg
    adsSimple2.prg
    AppSplitter.prg
    AppUtil.prg
    ArrayReportContainer.PRG
    dboInvoice.prg
    dboReportContainer.PRG
    dboSimple1.prg
    dboSimple2.prg
    dboSimple2Opt.prg
    DrillDown.PRG
    Expandable.PRG
    Invoice.prg
    Mail.prg
    Main.prg
    panRight.prg
    PDF.prg
    pgHtmlViewer2.prg
    PrintRestAPI.prg
    qrrechnung.prg
    reportcontainer.PRG
    resource\resource.arc
    Simple1.prg
    Simple2.prg
    Simple2Opt.prg
    Simple2Stream.prg
    SimpleArray.PRG
    SimpleDataObject.PRG
    SimpleDataObjectLBL.PRG
    SimpleInvoice.prg
    sqlADS.prg
    xRechnung.prg

