<?xml version="1.0" encoding="8859-1" standalone="yes"?>
<asset title="XbpHTMLViewer2 Control" version="1.12" locale="*" release="20251211" requires="2.00.2600" product="xbphtmlviewer2.found.Uq56uFBJosZtfiH2MZ5EdCrRcQLGRtPcVa9ehuiCaPo=" size="182812">
  <description>The XbpHTMLViewer2 control class implemented in this asset provides a replacement for
      the original XbpHTMLViewer class for displaying HTML/CSS-based content in Xbase++ 
      applications. The old class uses Internet Explorer technology which is being phased 
      out by many API and service vendors, including Google with its Maps platform. The new 
      XbpHTMLViewer2 class provided in this asset instead utilizes the same technology used 
      in Microsoft&apos;s Edge browser and is intended as a swap-in replacement for the original 
      class. 
      </description>
  <author name="Alaska Software"/>
  <copyright>Alaska Software, (c) 2025. All rights reserved</copyright>
  <filterdata>
    <category>Windows UI</category>
    <keyword>desktop-ui</keyword>
    <keyword>win32-gui</keyword>
    <keyword>html</keyword>
    <keyword>webview2</keyword>
    <keyword>Edge</keyword>
    <keyword>webbrowser</keyword>
  </filterdata>
  <dependencies/>
  <install>
    <copy src="*"/>
    <copy src="readme.md"/>
    <copy src="alaska-software.xbphtmlviewer2.dll"/>
    <copy src="alaska-software.xbphtmlviewer2.lib"/>
    <copy src="alaska-software.webview2core.dll"/>
    <copy src="example\xbphtmlviewer2-example.prg"/>
    <copy src="example\xbphtmlviewer2-example.xpj"/>
  </install>
  <deinstall>
    <delete src="*"/>
    <delete src="readme.md"/>
    <delete src="alaska-software.xbphtmlviewer2.dll"/>
    <delete src="alaska-software.xbphtmlviewer2.lib"/>
    <delete src="alaska-software.webview2core.dll"/>
    <delete src="example\xbphtmlviewer2-example.prg"/>
    <delete src="example\xbphtmlviewer2-example.xpj"/>
  </deinstall>
  <add>
    <dependsOn/>
  </add>
  <remove>
    <dependsOn/>
  </remove>
  <image>data:image/png;base64,</image>
</asset>
