[PROJECT]
    DEBUG                = yes
    INTERMEDIATE_DEBUG   = ..\.debug
    INTERMEDIATE_RELEASE = ..\.release
    TARGET_DIR	   = ..\
    VERSION       = 2.3
    PROJECT.XPJ

[PROJECT.XPJ]
    dsListLabel32.DLL
    xclListLabel32.DLL

[dsListLabel32.DLL]
    COMPILE              = xpp
    COMPILE_FLAGS        = /ga /wi /wl /wu /q /w /D__LL=32
    GUI                  = yes
    LINKER               = alink
    LINK_FLAGS           =
    RC_COMPILE           = arc
    RC_FLAGS             = /v /q
// $START-AUTODEPEND
    cmbtllX.obj
    dsListLabel.obj
// $STOP-AUTODEPEND
    cmbtllX.prg
    dsListLabel.arc
    dsListLabel.prg


[xclListLabel32.DLL]
    COMPILE              = xpp
    COMPILE_FLAGS        = /ga /wi /wl /wu /q /w /D__LL=32 /D_XCLASS
    GUI                  = yes
    LINKER               = alink
    LINK_FLAGS           =
    RC_COMPILE           = arc
    RC_FLAGS             = /v /q
// $START-AUTODEPEND
    cmbtllX.obj
    dsListLabel.obj
// $STOP-AUTODEPEND
    cmbtllX.prg
    dsListLabel.arc
    dsListLabel.prg


